# Local database (SQLite for development; swap the datasource for Postgres later)
DATABASE_URL="file:./dev.db"

# Session signing key
AUTH_SECRET=""

# Movie metadata provider. Without a key the app runs on the bundled mock catalog.
TMDB_API_KEY=""
TMDB_LANGUAGE="ja-JP"
TMDB_REGION="JP"

# Supabase Realtime for watch rooms (browser-safe values only).
# Without them the room falls back to polling.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Bearer token for the daily upkeep job (/api/cron/refresh).
# Set the same value in the hosting provider so the schedule can authenticate.
CRON_SECRET=""

# Optional AI classifier for the 8-axis feature generation.
# Gemini is the default when its key is present. Without a key, generation
# falls back to deterministic rules only.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"
AI_BACKFILL_BATCH_SIZE="10"

# Optional OpenAI fallback. Select with AI_PROVIDER="openai".
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
