# Local database (SQLite for development; swap the datasource for Postgres later)
DATABASE_URL="file:./dev.db"

# Session signing key
AUTH_SECRET=""

# Movie metadata provider. Without a key the app runs on the bundled mock catalog.
TMDB_API_KEY=""
TMDB_LANGUAGE="ja-JP"
TMDB_REGION="JP"

# Optional Devin API classifier for the 8-axis feature generation.
# Without a key, feature generation falls back to deterministic rules only.
DEVIN_API_KEY=""
DEVIN_API_BASE_URL="https://api.devin.ai"
# Polling / cost guards for the classification session.
DEVIN_POLL_INTERVAL_MS="5000"
DEVIN_TIMEOUT_MS="180000"
DEVIN_MAX_ACU_LIMIT="3"
