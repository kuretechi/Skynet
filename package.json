{
  "name": "skynet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/recommend/personal.test.ts src/lib/ratings/toggle.test.ts src/lib/signatures/similarity.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "slides:pdf": "marp docs/slides/pitch.md --pdf --allow-local-files -o docs/slides/pitch.pdf",
    "db:schema": "node scripts/sync-prisma-schema.mjs",
    "db:push": "npm run db:schema && node scripts/db-push.mjs",
    "db:migrate": "npm run db:schema && node scripts/db-migrate.mjs",
    "db:migrate:new": "npm run db:schema && node scripts/db-migrate-new.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "catalogue:bootstrap": "node scripts/bootstrap-catalogue.mjs",
    "setup": "npm run db:schema && prisma generate && node scripts/db-push.mjs && tsx prisma/seed.ts",
    "postinstall": "npm run db:schema && prisma generate",
    "vercel-build": "npm run db:schema && prisma generate && node scripts/db-migrate.mjs && next build"
  },
  "prisma": {
    "schema": "prisma/schema.generated.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@supabase/realtime-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "next": "15.5.23",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@marp-team/marp-cli": "^4.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
